# hh.ru API
# Add the application access token only to your local .env or cloud Secrets.
HH_API_TOKEN=

# Database (for local development SQLite is used by default)
# For Neon/PostgreSQL set DB_BACKEND=postgres and fill in the values below.
DB_BACKEND=sqlite
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Collection limits
COLLECT_QUERIES=Python разработчик
COLLECT_AREAS=1
COLLECT_PER_PAGE=50
COLLECT_MAX_PAGES=5
COLLECT_MAX_VACANCIES=500
COLLECT_FETCH_DETAILS=true
COLLECT_DELAY_SEC=0.5
